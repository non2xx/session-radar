{
  "name": "session-radar",
  "displayName": "session-radar",
  "description": "Claude Code session status panel (tmux, remote)",
  "version": "0.8.3",
  "license": "MIT",
  "icon": "assets/icon.png",
  "keywords": [
    "claude",
    "claude code",
    "tmux",
    "sessions",
    "status",
    "remote"
  ],
  "publisher": "non2xx",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/non2xx/session-radar.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:sessionRadar.view",
    "onView:sessionRadar.cards",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionRadar",
          "title": "session-radar",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "sessionRadar": [
        {
          "id": "sessionRadar.view",
          "name": "Sessions"
        },
        {
          "id": "sessionRadar.cards",
          "name": "Sessions (카드)",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionRadar.refresh",
        "title": "새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionRadar.addGroup",
        "title": "그룹 추가",
        "icon": "$(new-folder)"
      },
      {
        "command": "sessionRadar.addSession",
        "title": "세션 추가",
        "icon": "$(add)"
      },
      {
        "command": "sessionRadar.renameGroup",
        "title": "그룹 이름변경"
      },
      {
        "command": "sessionRadar.deleteGroup",
        "title": "그룹 삭제"
      },
      {
        "command": "sessionRadar.renameSession",
        "title": "이름변경(별명)"
      },
      {
        "command": "sessionRadar.hideSession",
        "title": "목록에서 삭제"
      },
      {
        "command": "sessionRadar.setPath",
        "title": "프로젝트 경로 지정"
      },
      {
        "command": "sessionRadar.clearPath",
        "title": "경로 지우기"
      },
      {
        "command": "sessionRadar.jumpSplit",
        "title": "분할로 열기"
      },
      {
        "command": "sessionRadar.closeTerminal",
        "title": "분할 닫기"
      },
      {
        "command": "sessionRadar.compareImages",
        "title": "이미지 나란히 보기",
        "icon": "$(file-media)"
      },
      {
        "command": "sessionRadar.compareImagesAdd",
        "title": "이미지 비교에 추가"
      },
      {
        "command": "sessionRadar.resetImageColumns",
        "title": "이미지 칸 배치 처음부터"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionRadar.addGroup",
          "when": "view == sessionRadar.view",
          "group": "navigation"
        },
        {
          "command": "sessionRadar.addSession",
          "when": "view == sessionRadar.view",
          "group": "navigation"
        },
        {
          "command": "sessionRadar.refresh",
          "when": "view == sessionRadar.view",
          "group": "navigation"
        },
        {
          "command": "sessionRadar.addGroup",
          "when": "view == sessionRadar.cards",
          "group": "navigation"
        },
        {
          "command": "sessionRadar.addSession",
          "when": "view == sessionRadar.cards",
          "group": "navigation"
        },
        {
          "command": "sessionRadar.refresh",
          "when": "view == sessionRadar.cards",
          "group": "navigation"
        },
        {
          "command": "sessionRadar.compareImages",
          "when": "view == sessionRadar.view",
          "group": "navigation"
        },
        {
          "command": "sessionRadar.compareImages",
          "when": "view == sessionRadar.cards",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionRadar.renameGroup",
          "when": "view == sessionRadar.view && viewItem == group"
        },
        {
          "command": "sessionRadar.deleteGroup",
          "when": "view == sessionRadar.view && viewItem == group"
        },
        {
          "command": "sessionRadar.jumpSplit",
          "when": "view == sessionRadar.view && viewItem == session"
        },
        {
          "command": "sessionRadar.closeTerminal",
          "when": "view == sessionRadar.view && viewItem == session"
        },
        {
          "command": "sessionRadar.renameSession",
          "when": "view == sessionRadar.view && viewItem == session"
        },
        {
          "command": "sessionRadar.hideSession",
          "when": "view == sessionRadar.view && viewItem == session"
        },
        {
          "command": "sessionRadar.setPath",
          "when": "view == sessionRadar.view && viewItem == session"
        },
        {
          "command": "sessionRadar.clearPath",
          "when": "view == sessionRadar.view && viewItem == session"
        }
      ]
    },
    "configuration": {
      "title": "session-radar",
      "properties": {
        "sessionRadar.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "VS Code 시작 시 직전에 열려 있던 세션 터미널을 자동으로 다시 엽니다."
        },
        "sessionRadar.terminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "default": "panel",
          "description": "세션 터미널을 여는 위치 — panel(하단 패널, 코드가 메인) 또는 editor(메인 에디터 영역, 터미널이 메인). '분할로 열기'는 설정과 무관하게 항상 에디터 영역에 좌우로 타일됩니다."
        },
        "sessionRadar.imageSplitOnClick": {
          "type": "boolean",
          "default": true,
          "description": "터미널에서 이미지 경로를 Ctrl+클릭하면 새 탭 대신 오른쪽 격자에 나란히 엽니다. 끄면 VS Code 기본 동작(새 탭)으로 돌아갑니다."
        },
        "sessionRadar.showSubagents": {
          "type": "boolean",
          "default": true,
          "description": "세션 아래에 그 세션이 돌리는 서브에이전트를 펼쳐 보여줍니다. 끄면 목록 조회도 하지 않습니다."
        },
        "sessionRadar.agentsRefreshSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 300,
          "description": "서브에이전트 목록을 몇 초마다 다시 읽을지. 세션 상태(3초)와 따로 돕니다 — 이 조회가 느려서 화면이 끊기지 않게 하려는 것입니다."
        },
        "sessionRadar.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "claude 실행 파일. 서브에이전트 목록이 비어 있으면 `which claude` 결과를 전체 경로로 적어 주세요 (VS Code 가 nvm 경로를 못 볼 때가 있습니다)."
        },
        "sessionRadar.imageMaxOpen": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 6,
          "description": "격자에 몇 장까지 펼칠지. 이 수를 넘으면 첫 칸부터 다시 채웁니다. 2장은 위아래, 3장은 위 둘 아래 하나, 4장은 2x2."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies -o session-radar.vsix"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3",
    "esbuild": "^0.24",
    "typescript": "^5.5",
    "vitest": "^2"
  }
}
